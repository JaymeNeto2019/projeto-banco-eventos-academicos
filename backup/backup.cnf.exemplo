# Copie para backup.cnf (está no .gitignore) e preencha. Use um usuário SÓ de backup, com o mínimo de privilégios:
#   CREATE USER 'usr_backup'@'localhost' IDENTIFIED BY '...';
#   GRANT SELECT, SHOW VIEW, TRIGGER, EVENT, LOCK TABLES ON eventos_academicos.* TO 'usr_backup'@'localhost';
#   GRANT PROCESS ON *.* TO 'usr_backup'@'localhost';
# Para o teste de restauração, o usuário precisa também de CREATE/DROP no banco temporário:
#   GRANT ALL ON `eventos_academicos_restore_test`.* TO 'usr_backup'@'localhost';
[client]
user=usr_backup
password=TROQUE_ESTA_SENHA
host=localhost
