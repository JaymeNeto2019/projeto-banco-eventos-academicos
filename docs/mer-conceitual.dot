digraph ER {
graph [rankdir=LR, splines=ortho, nodesep=0.5, ranksep=0.9, pad=0.2, bgcolor="white"];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=9, color="#444444", arrowsize=0.7];
pessoa [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>PESSOA</B><BR/><FONT POINT-SIZE="10">&lt;&lt;supertipo&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK id_pessoa<BR ALIGN="LEFT"/>nome<BR ALIGN="LEFT"/>email {UQ}<BR ALIGN="LEFT"/>telefone<BR ALIGN="LEFT"/>data_nascimento</FONT></TD></TR></TABLE>>];
instituicao [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>INSTITUICAO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK id_instituicao<BR ALIGN="LEFT"/>nome<BR ALIGN="LEFT"/>sigla {UQ}<BR ALIGN="LEFT"/>tipo<BR ALIGN="LEFT"/>cidade / UF</FONT></TD></TR></TABLE>>];
participante [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>PARTICIPANTE</B><BR/><FONT POINT-SIZE="10">&lt;&lt;subtipo&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK/FK id_pessoa<BR ALIGN="LEFT"/>tipo_participante<BR ALIGN="LEFT"/>matricula_academica {UQ}<BR ALIGN="LEFT"/>FK id_instituicao_origem</FONT></TD></TR></TABLE>>];
organizador [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>ORGANIZADOR</B><BR/><FONT POINT-SIZE="10">&lt;&lt;subtipo&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK/FK id_pessoa<BR ALIGN="LEFT"/>cargo<BR ALIGN="LEFT"/>setor<BR ALIGN="LEFT"/>ativo</FONT></TD></TR></TABLE>>];
categoria [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>CATEGORIA_EVENTO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK id_categoria<BR ALIGN="LEFT"/>nome {UQ}<BR ALIGN="LEFT"/>descricao<BR ALIGN="LEFT"/>FK id_categoria_pai</FONT></TD></TR></TABLE>>];
evento [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>EVENTO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK id_evento<BR ALIGN="LEFT"/>FK id_categoria<BR ALIGN="LEFT"/>FK id_instituicao_promotora<BR ALIGN="LEFT"/>titulo<BR ALIGN="LEFT"/>data_inicio / data_fim<BR ALIGN="LEFT"/>modalidade<BR ALIGN="LEFT"/>limite_participantes<BR ALIGN="LEFT"/>gratuito / valor_inscricao</FONT></TD></TR></TABLE>>];
historico [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>HISTORICO_STATUS_EVENTO</B><BR/><FONT POINT-SIZE="10">&lt;&lt;entidade fraca + temporal&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK/FK id_evento<BR ALIGN="LEFT"/>PK sequencia<BR ALIGN="LEFT"/>status<BR ALIGN="LEFT"/>data_hora<BR ALIGN="LEFT"/>observacao</FONT></TD></TR></TABLE>>];
atividade [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>ATIVIDADE</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK id_atividade<BR ALIGN="LEFT"/>FK id_evento<BR ALIGN="LEFT"/>titulo<BR ALIGN="LEFT"/>tipo_atividade<BR ALIGN="LEFT"/>carga_horaria<BR ALIGN="LEFT"/>vagas<BR ALIGN="LEFT"/>obrigatoria</FONT></TD></TR></TABLE>>];
sala [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>SALA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK id_sala<BR ALIGN="LEFT"/>nome<BR ALIGN="LEFT"/>bloco<BR ALIGN="LEFT"/>capacidade<BR ALIGN="LEFT"/>acessivel</FONT></TD></TR></TABLE>>];
sessao [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>SESSAO_ATIVIDADE</B><BR/><FONT POINT-SIZE="10">&lt;&lt;entidade fraca&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK/FK id_atividade<BR ALIGN="LEFT"/>PK numero_sessao<BR ALIGN="LEFT"/>FK id_sala<BR ALIGN="LEFT"/>inicio / fim<BR ALIGN="LEFT"/>observacao</FONT></TD></TR></TABLE>>];
inscricao [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>INSCRICAO_ATIVIDADE</B><BR/><FONT POINT-SIZE="10">&lt;&lt;associativa N:N&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK/FK id_participante<BR ALIGN="LEFT"/>PK/FK id_atividade<BR ALIGN="LEFT"/>data_inscricao<BR ALIGN="LEFT"/>status_inscricao<BR ALIGN="LEFT"/>percentual_presenca<BR ALIGN="LEFT"/>nota_avaliacao</FONT></TD></TR></TABLE>>];
organizacao [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>ORGANIZACAO_EVENTO</B><BR/><FONT POINT-SIZE="10">&lt;&lt;associativa N:N&gt;&gt;</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK/FK id_organizador<BR ALIGN="LEFT"/>PK/FK id_evento<BR ALIGN="LEFT"/>papel<BR ALIGN="LEFT"/>data_inicio_atuacao<BR ALIGN="LEFT"/>responsavel_principal</FONT></TD></TR></TABLE>>];
certificado [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>CERTIFICADO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK id_certificado<BR ALIGN="LEFT"/>FK id_participante<BR ALIGN="LEFT"/>FK id_evento<BR ALIGN="LEFT"/>codigo_validacao {UQ}<BR ALIGN="LEFT"/>emitido_em<BR ALIGN="LEFT"/>carga_horaria</FONT></TD></TR></TABLE>>];
pessoa -> participante [label="especialização", taillabel="1", headlabel="0..1", dir=both, arrowhead=none, arrowtail=none];
pessoa -> organizador [label="especialização", taillabel="1", headlabel="0..1", dir=both, arrowhead=none, arrowtail=none];
instituicao -> participante [label="origem", taillabel="0..N", headlabel="0..1", dir=both, arrowhead=none, arrowtail=none];
categoria -> categoria [label="pai / subcategoria", taillabel="0..N", headlabel="0..1", dir=both, arrowhead=none, arrowtail=none, constraint=false];
categoria -> evento [label="classifica", taillabel="0..N", headlabel="1", dir=both, arrowhead=none, arrowtail=none];
instituicao -> evento [label="promove", taillabel="0..N", headlabel="1", dir=both, arrowhead=none, arrowtail=none];
evento -> historico [label="possui", taillabel="1", headlabel="1..N", dir=both, arrowhead=none, arrowtail=none];
evento -> atividade [label="compõe", taillabel="1", headlabel="1..N", dir=both, arrowhead=none, arrowtail=none];
atividade -> sessao [label="ocorre em", taillabel="1", headlabel="1..N", dir=both, arrowhead=none, arrowtail=none];
sala -> sessao [label="recebe", taillabel="0..N", headlabel="1", dir=both, arrowhead=none, arrowtail=none];
participante -> inscricao [label="realiza", taillabel="1", headlabel="0..N", dir=both, arrowhead=none, arrowtail=none];
atividade -> inscricao [label="recebe", taillabel="1", headlabel="0..N", dir=both, arrowhead=none, arrowtail=none];
organizador -> organizacao [label="atua", taillabel="1", headlabel="0..N", dir=both, arrowhead=none, arrowtail=none];
evento -> organizacao [label="é organizado por", taillabel="1", headlabel="1..N", dir=both, arrowhead=none, arrowtail=none];
participante -> certificado [label="recebe", taillabel="1", headlabel="0..N", dir=both, arrowhead=none, arrowtail=none];
evento -> certificado [label="gera", taillabel="1", headlabel="0..N", dir=both, arrowhead=none, arrowtail=none];
note [shape=note, fontname="DejaVu Sans", fontsize=9, label="Especialização de PESSOA: parcial e sobreposta\nEntidades fracas: HISTORICO_STATUS_EVENTO e SESSAO_ATIVIDADE\nAssociações N:N com atributos próprios: INSCRICAO_ATIVIDADE e ORGANIZACAO_EVENTO"];
}