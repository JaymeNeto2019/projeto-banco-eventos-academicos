digraph LOGICO {
graph [rankdir=LR, splines=ortho, nodesep=0.45, ranksep=0.85, pad=0.2, bgcolor="white"];
node [shape=plain, fontname="DejaVu Sans"];
edge [fontname="DejaVu Sans", fontsize=8, color="#555555", arrowsize=0.6];
pessoa [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>PESSOA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK id_pessoa BIGINT<BR ALIGN="LEFT"/>nome VARCHAR(120)<BR ALIGN="LEFT"/>UQ email VARCHAR(160)<BR ALIGN="LEFT"/>telefone VARCHAR(20) NULL<BR ALIGN="LEFT"/>data_nascimento DATE NULL<BR ALIGN="LEFT"/>criado_em TIMESTAMP</FONT></TD></TR></TABLE>>];
instituicao [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>INSTITUICAO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK id_instituicao INT<BR ALIGN="LEFT"/>nome VARCHAR(150)<BR ALIGN="LEFT"/>UQ sigla VARCHAR(20)<BR ALIGN="LEFT"/>tipo VARCHAR(10)<BR ALIGN="LEFT"/>cidade VARCHAR(80)<BR ALIGN="LEFT"/>uf CHAR(2)<BR ALIGN="LEFT"/>site VARCHAR(200) NULL</FONT></TD></TR></TABLE>>];
participante [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>PARTICIPANTE</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK/FK id_pessoa BIGINT<BR ALIGN="LEFT"/>tipo_participante VARCHAR(10)<BR ALIGN="LEFT"/>UQ matricula_academica VARCHAR(30) NULL<BR ALIGN="LEFT"/>FK id_instituicao_origem INT NULL</FONT></TD></TR></TABLE>>];
organizador [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>ORGANIZADOR</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK/FK id_pessoa BIGINT<BR ALIGN="LEFT"/>cargo VARCHAR(80)<BR ALIGN="LEFT"/>setor VARCHAR(100)<BR ALIGN="LEFT"/>ativo BOOLEAN</FONT></TD></TR></TABLE>>];
categoria [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>CATEGORIA_EVENTO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK id_categoria INT<BR ALIGN="LEFT"/>UQ nome VARCHAR(100)<BR ALIGN="LEFT"/>descricao VARCHAR(300) NULL<BR ALIGN="LEFT"/>FK id_categoria_pai INT NULL</FONT></TD></TR></TABLE>>];
evento [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>EVENTO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK id_evento BIGINT<BR ALIGN="LEFT"/>FK id_categoria INT<BR ALIGN="LEFT"/>FK id_instituicao_promotora INT<BR ALIGN="LEFT"/>titulo VARCHAR(180)<BR ALIGN="LEFT"/>data_inicio DATETIME<BR ALIGN="LEFT"/>data_fim DATETIME<BR ALIGN="LEFT"/>modalidade VARCHAR(12)<BR ALIGN="LEFT"/>limite_participantes INT NULL<BR ALIGN="LEFT"/>gratuito BOOLEAN<BR ALIGN="LEFT"/>valor_inscricao DECIMAL(10,2)<BR ALIGN="LEFT"/>url_evento VARCHAR(250) NULL</FONT></TD></TR></TABLE>>];
historico [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>HISTORICO_STATUS_EVENTO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK/FK id_evento BIGINT<BR ALIGN="LEFT"/>PK sequencia INT<BR ALIGN="LEFT"/>status VARCHAR(12)<BR ALIGN="LEFT"/>data_hora DATETIME<BR ALIGN="LEFT"/>observacao VARCHAR(300) NULL</FONT></TD></TR></TABLE>>];
atividade [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>ATIVIDADE</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK id_atividade BIGINT<BR ALIGN="LEFT"/>FK id_evento BIGINT<BR ALIGN="LEFT"/>titulo VARCHAR(180)<BR ALIGN="LEFT"/>tipo_atividade VARCHAR(20)<BR ALIGN="LEFT"/>carga_horaria DECIMAL(4,1)<BR ALIGN="LEFT"/>vagas INT<BR ALIGN="LEFT"/>obrigatoria BOOLEAN</FONT></TD></TR></TABLE>>];
sala [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>SALA</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK id_sala INT<BR ALIGN="LEFT"/>nome VARCHAR(80)<BR ALIGN="LEFT"/>bloco VARCHAR(50)<BR ALIGN="LEFT"/>capacidade INT<BR ALIGN="LEFT"/>acessivel BOOLEAN<BR ALIGN="LEFT"/>UQ (nome, bloco)</FONT></TD></TR></TABLE>>];
sessao [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>SESSAO_ATIVIDADE</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK/FK id_atividade BIGINT<BR ALIGN="LEFT"/>PK numero_sessao INT<BR ALIGN="LEFT"/>FK id_sala INT<BR ALIGN="LEFT"/>inicio DATETIME<BR ALIGN="LEFT"/>fim DATETIME<BR ALIGN="LEFT"/>observacao VARCHAR(300) NULL</FONT></TD></TR></TABLE>>];
inscricao [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>INSCRICAO_ATIVIDADE</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK/FK id_participante BIGINT<BR ALIGN="LEFT"/>PK/FK id_atividade BIGINT<BR ALIGN="LEFT"/>data_inscricao DATETIME<BR ALIGN="LEFT"/>status_inscricao VARCHAR(15)<BR ALIGN="LEFT"/>percentual_presenca DECIMAL(5,2) NULL<BR ALIGN="LEFT"/>nota_avaliacao DECIMAL(3,1) NULL</FONT></TD></TR></TABLE>>];
organizacao [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>ORGANIZACAO_EVENTO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK/FK id_organizador BIGINT<BR ALIGN="LEFT"/>PK/FK id_evento BIGINT<BR ALIGN="LEFT"/>papel VARCHAR(80)<BR ALIGN="LEFT"/>data_inicio_atuacao DATE<BR ALIGN="LEFT"/>responsavel_principal BOOLEAN</FONT></TD></TR></TABLE>>];
certificado [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD><B>CERTIFICADO</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">PK id_certificado BIGINT<BR ALIGN="LEFT"/>FK id_participante BIGINT<BR ALIGN="LEFT"/>FK id_evento BIGINT<BR ALIGN="LEFT"/>UQ codigo_validacao VARCHAR(40)<BR ALIGN="LEFT"/>emitido_em DATETIME<BR ALIGN="LEFT"/>carga_horaria DECIMAL(5,1)<BR ALIGN="LEFT"/>UQ (id_participante,id_evento)</FONT></TD></TR></TABLE>>];
participante -> pessoa [label="FK"];
participante -> instituicao [label="FK"];
organizador -> pessoa [label="FK"];
categoria -> categoria [label="FK", constraint=false];
evento -> categoria [label="FK"];
evento -> instituicao [label="FK"];
historico -> evento [label="FK"];
atividade -> evento [label="FK"];
sessao -> atividade [label="FK"];
sessao -> sala [label="FK"];
inscricao -> participante [label="FK"];
inscricao -> atividade [label="FK"];
organizacao -> organizador [label="FK"];
organizacao -> evento [label="FK"];
certificado -> participante [label="FK"];
certificado -> evento [label="FK"];
}